{
  "name": "service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test lib/*.test.ts lib/ai/*.test.ts lib/rules/*.test.ts lib/harness/*.test.ts lib/ontology/*.test.ts",
    "verify": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-golden.mjs && node scripts/contrast.mjs",
    "scan": "node scripts/scan.mjs && node scripts/scan.mjs --selftest",
    "smoke": "node scripts/smoke.mjs",
    "ci": "npm run typecheck && npm test && npm run verify && npm run scan && npm run build"
  },
  "dependencies": {
    "next": "16.3.1",
    "pretendard": "^1.3.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
